{
  "opencollection": "1.0.0",
  "info": {
    "name": "Height APP Activities Workspace API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Workspace",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve the workspace",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.height.app/workspace"
          },
          "docs": "Retrieve the workspace"
        }
      ]
    }
  ],
  "bundled": true
}