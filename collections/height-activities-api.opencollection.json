{
  "opencollection": "1.0.0",
  "info": {
    "name": "Height APP Activities API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Activities",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List activities and messages",
            "type": "http"
          },
          "http": {
            "method": "GET",
