                "description": "Either the task unique `id` (UUID), or the task unique `index` (the 123 of T-123)."
              }
            ]
          },
          "docs": "List activities and messages"
        },
        {
          "info": {
            "name": "Post a message",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.height.app/activities",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Post a message"
        }
      ]
    }
  ],
  "bundled": true
}